# ------------------------------------------------------------------------
# HTCondor submit file for stau analysis stage 1 (OutsideInTrackingStudies/
# Stau/stauAccumulator.py), one job per reco file. Reads
#   $(OUTPUT_ROOT)/$(SAMPLE)/$(RECO_DIR)/$(SAMPLE)_reco$(PID).edm4hep.root
# and writes
#   $(OUTPUT_ROOT)/$(SAMPLE)/acc_$(RECO_DIR)/$(SAMPLE)_acc$(PID).pkl
# Stage 2: list acc_$(RECO_DIR) in edm4hepStauTrackAnalyzer.py's file_names.
#
# Submitted through submit_all_stauacc.sh, which sets SAMPLE and RECO_DIR and
# queues one job per existing reco file (-queue "PID from <list>").
# The analyzer is transferred when each job STARTS: edits reach queued jobs.
# ------------------------------------------------------------------------

OUTPUT_ROOT  = /ospool/uc-shared/project/futurecolliders/larsonma
BENCH_ROOT   = /scratch/larsonma/tutorial2024/ACTSGaudi/TemplateWorkspace/mucoll-benchmarks
STAU_DIR     = $(BENCH_ROOT)/OutsideInTrackingStudies/Stau

# Same image as reco.submit, so podio / EDM4hep match the files.
CONTAINER_IMAGE = /cvmfs/public-uc.osgstorage.org/ospool/uc-shared/public/futurecolliders/larsonma/mucoll-sim-ubuntu24_full_gaudi_103126_latest.sif

Universe                = vanilla
+SingularityImage       = "$(CONTAINER_IMAGE)"
# Reco input / result output move over OSDF via pelican (see stauacc.sh).
Requirements            = ( HAS_SINGULARITY =?= True ) && ( HAS_CVMFS_public_uc_osgstorage_org =?= True )

Executable              = $(BENCH_ROOT)/condor/stauacc/stauacc.sh
Arguments               = --sample $(SAMPLE) --outputRoot $(OUTPUT_ROOT) --recoDir $(RECO_DIR) --pId $(PID)

should_transfer_files   = YES
when_to_transfer_output = ON_EXIT
# common.sh also sets up the MAIA config, hence configs/ and setup_config.sh.
transfer_input_files    = $(BENCH_ROOT)/condor/common.sh, \
                          $(BENCH_ROOT)/configs, \
                          $(BENCH_ROOT)/setup_config.sh, \
                          $(STAU_DIR)/stauAccumulator.py, \
                          $(STAU_DIR)/edm4hepStauTrackAnalyzer.py
transfer_output_files   = ""

Output = $(BENCH_ROOT)/condor/stauacc/logs/out.$(Cluster).$(ProcId)
Error  = $(BENCH_ROOT)/condor/stauacc/logs/err.$(Cluster).$(ProcId)
Log    = $(BENCH_ROOT)/condor/stauacc/logs/log.$(Cluster)

# Coned full-BIB reco files are ~1.3 GB for 2 events; a guess, check MemoryUsage.
request_cpus    = 1
request_disk    = 4 GB
request_memory  = 8 GB
+ProjectName    = "collab.futurecolliders"
